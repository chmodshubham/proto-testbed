# TLS 1.3 PQC mode

[tls_server]
tls1_3 = yes
groups = X25519MLKEM768:SecP256r1MLKEM768:X25519:P-256
ciphersuites = TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256
sigalgs = mldsa65:mldsa87:mldsa44:ecdsa_secp256r1_sha256:ecdsa_secp384r1_sha384

[tls_client]
tls1_3 = yes
groups = X25519MLKEM768:SecP256r1MLKEM768:X25519:P-256
ciphersuites = TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256
sigalgs = mldsa65:mldsa87:mldsa44:ecdsa_secp256r1_sha256:ecdsa_secp384r1_sha384
